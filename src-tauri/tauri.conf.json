{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notez",
  "version": "0.2.0",
  "identifier": "com.donald.notez",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteZ",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true,
        "backgroundColor": "#f6f6f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "description": "NoteZ",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "role": "Editor"
      }
    ],
    "resources": [
      "resources/plantuml-runtime/"
    ]
  }
}
